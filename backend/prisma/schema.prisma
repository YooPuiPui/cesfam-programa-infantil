// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// enums
enum EstadoConvocatoria {
  no_contactado
  contactado
  confirma
  no_confirma
  no_contesta
  no_puede
  reconfirmar
}

enum EstadoAsistencia {
  pendiente
  asiste
  no_asiste
}

enum EstadoCredencialDiscapacidad {
  sin_dato
  si
  no
  en_tramite
}

// CONDICION = condicion de base del paciente, CONTROL = diagnostico de un control clinico
enum TipoDiagnostico {
  CONDICION
  CONTROL
}

// 1. Tabla Profesionales
model Profesional {
  id_profesional Int      @id @default(autoincrement())
  rut            String   @unique @db.VarChar(12)
  nombre         String   @db.VarChar(100)
  apellido       String   @db.VarChar(100)
  estamento      String   @db.VarChar(50)
  activo         Boolean  @default(true)
  creado_en      DateTime @default(now())

  // relacion 
  controlClinico ControlClinico[]
  sesionesTaller SesionTaller[]
}

// 2. Tabla Tutores
model Tutor {
  id_tutor            Int     @id @default(autoincrement())
  rut                 String? @unique @db.VarChar(12)
  nombre              String  @db.VarChar(100)
  apellido            String  @db.VarChar(100)
  telefono            String  @db.VarChar(15)
  telefono_secundario String? @db.VarChar(15)
  parentesco          String  @db.VarChar(50)
  correo              String? @db.VarChar(100)
  direccion           String  @db.VarChar(100)
  sector              String? @db.VarChar(100)
  verificado          Boolean @default(true)

  id_comuna Int
  comuna    Comuna @relation(fields: [id_comuna], references: [id_comuna])

  // Una relación de uno a muchos: un tutor puede tener muchos Pacientes
  pacientes Paciente[]
}

model Comuna {
  id_comuna Int    @id @default(autoincrement())
  nombre    String @unique @db.VarChar(100)

  tutores  Tutor[]
  paciente Paciente[]
}

model Cuidador {
  id_cuidador Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(100)
  apellidos   String? @db.VarChar(100)
  telefono    String? @db.VarChar(15)
  parentesco  String? @db.VarChar(50)

  // un cuidador puede estar asociado a varios pacientes
  paciente Paciente[]
}

// 3. Tabla de Pacientes
model Paciente {
  id_paciente       Int      @id @default(autoincrement())
  rut               String   @unique @db.VarChar(15)
  nombre            String   @db.VarChar(100)
  apellido          String   @db.VarChar(100)
  nombre_social     String?  @db.VarChar(100)
  fecha_nacimiento  DateTime @db.Date
  sexo_biologico    String   @db.VarChar(20)
  identidad_genero  String?  @db.VarChar(50)
  nacionalidad      String?  @default("Chilena") @db.VarChar(50)
  direccion         String
  sector            String?  @db.VarChar(50)
  nhc               String?  @db.VarChar(50) // numero hostorial clinico
  prevision         String?  @db.VarChar(50) // ej fonasa gpo-a 
  fecha_inscripcion DateTime @default(now()) // en que se inscribio en el cesfam
  activo            Boolean  @default(true)

  // Flags de riesgo social 
  es_sename           Boolean  @default(false)
  es_naneas_prematuro Boolean  @default(false)
  es_poblacion_trans  Boolean  @default(false)
  es_migrante         Boolean  @default(false)
  es_salud_mental     Boolean  @default(false) // pertenece al programa de salud mental
  creado_en           DateTime @default(now())

  // condiciones de base del paciente (catalogo Diagnostico de tipo CONDICION)
  diagnosticosRel PacienteDiagnostico[]

  //  credencial de discapacidad
  credencial_discapacidad         EstadoCredencialDiscapacidad @default(sin_dato)
  credencial_discapacidad_detalle String?                      @db.Text

  // cuidador (distinto del tutor legal, opcional)
  id_cuidador Int?
  cuidador    Cuidador? @relation(fields: [id_cuidador], references: [id_cuidador])

  // Relación con el tutor
  id_tutor_principal Int
  tutor              Tutor @relation(fields: [id_tutor_principal], references: [id_tutor])

  // Relación con la comuna
  id_comuna Int
  comuna    Comuna @relation(fields: [id_comuna], references: [id_comuna])

  controlClinico      ControlClinico[]
  inscripcionesTaller InscripcionTaller[]

  @@index([id_tutor_principal])
}

model ControlClinico {
  id_control    Int      @id @default(autoincrement())
  fecha_control DateTime @default(now())

  motivo_consulta    String? @db.Text
  anamnesis          String? @db.Text
  exploracion_fisica String? @db.Text

  // medidas
  edad_meses         Int
  peso_kg            Float
  talla_cm           Float
  perimetro_cefalico Float?
  imc                Float?

  // notas clinicas
  problemas_diagnosticados String? @db.Text
  indicaciones_acuerdos    String? @db.Text

  // gestion control
  fecha_proximoControl DateTime @db.Date

  // forean key - relacion
  rut_paciente String
  paciente     Paciente @relation(fields: [rut_paciente], references: [rut])

  rut_profesional String
  Profesional     Profesional @relation(fields: [rut_profesional], references: [rut])

  creado_en DateTime @default(now())

  diagnosticosRel ControlDiagnostico[]

  @@index([rut_paciente, fecha_control])
  @@index([fecha_proximoControl])
}

model Diagnostico {
  id_diagnostico Int             @id @default(autoincrement())
  nombre         String          @unique @db.VarChar(120) // etiqueta propia del sistema, NO es la glosa oficial de la CIE-10
  tipo           TipoDiagnostico
  codigo_cie10   String?         @db.VarChar(10) // codigo CIE-10 MINSAL/DEIS v2018 de referencia, null si no hay equivalente
  activo         Boolean         @default(true)

  pacientes PacienteDiagnostico[]
  controles ControlDiagnostico[]

  @@index([tipo, activo])
}

model PacienteDiagnostico {
  id_paciente    Int
  id_diagnostico Int

  paciente    Paciente    @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  diagnostico Diagnostico @relation(fields: [id_diagnostico], references: [id_diagnostico], onDelete: Restrict)

  @@id([id_paciente, id_diagnostico])
  @@index([id_diagnostico])
}

model ControlDiagnostico {
  id_control     Int
  id_diagnostico Int

  control     ControlClinico @relation(fields: [id_control], references: [id_control], onDelete: Cascade)
  diagnostico Diagnostico    @relation(fields: [id_diagnostico], references: [id_diagnostico], onDelete: Restrict)

  @@id([id_control, id_diagnostico])
  @@index([id_diagnostico])
}

model Usuario {
  id        Int      @id @default(autoincrement())
  rut       String   @unique
  password  String
  nombre    String
  rol       String   @default("Medico")
  createdAt DateTime @default(now())
}

model Taller {
  id_taller   Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.Text

  edad_min  Int      @default(0)
  edad_max  Int      @default(18)
  activo    Boolean  @default(true)
  creado_en DateTime @default(now())

  sesiones SesionTaller[]
}

model SesionTaller {
  id_sesion Int @id @default(autoincrement())

  id_taller Int
  taller    Taller @relation(fields: [id_taller], references: [id_taller])

  fecha       DateTime @db.Date
  cupo_maximo Int? // sin validacion ya que no existe maximo

  rut_profesional     String?      @db.VarChar(12)
  profesional         Profesional? @relation(fields: [rut_profesional], references: [rut])
  profesional_externo String?      @db.VarChar(150) // para interno o de otro cesfam

  terminada     Boolean  @default(false) // al terminarla se cierra la asistencia
  observaciones String?  @db.Text
  creado_en     DateTime @default(now())

  inscripciones InscripcionTaller[]

  @@index([id_taller, fecha])
}

model InscripcionTaller {
  id_inscripcion Int @id @default(autoincrement())

  rut_paciente String
  paciente     Paciente     @relation(fields: [rut_paciente], references: [rut])
  id_sesion    Int
  sesion       SesionTaller @relation(fields: [id_sesion], references: [id_sesion])

  estado_convocatoria EstadoConvocatoria @default(no_contactado)
  estado_asistencia   EstadoAsistencia   @default(pendiente)

  telefono_contacto String? @db.VarChar(20)
  observaciones     String? @db.Text

  fecha_contacto DateTime?
  creado_en      DateTime  @default(now())
  actualizado_en DateTime  @updatedAt

  @@unique([rut_paciente, id_sesion])
  @@index([id_sesion])
}
